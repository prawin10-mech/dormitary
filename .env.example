# ============================================================================
#  Dormitary — environment template
#  Copy to `.env.local` (git-ignored) and fill in real values. NEVER commit secrets.
#
#  Rule of thumb:
#   - NEXT_PUBLIC_*  -> shipped to the browser. Safe ONLY for non-secret values.
#   - everything else -> server-only (API route handlers), never sent to the client.
# ============================================================================

# ---- Database (server-only) ----
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/dormitary"

# ---- Auth (server-only) ----
# Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET="replace-with-a-long-random-secret"
# How long an access token stays valid.
JWT_EXPIRES_IN="7d"

# ---- Cloudinary (server-only) ----
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ---- App ----
NEXT_PUBLIC_TITLE="Dormitary"

# ---- Cron (server-only) ----
# Secret guarding /api/cron/expire-beds. Set this, then point Vercel Cron (or any
# scheduler) at that route with header: Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="replace-with-a-long-random-secret"
